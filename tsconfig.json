{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@sneakdrop/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": [
    "packages/shared/src/**/*",
    "apps/api/src/**/*",
    "scripts/**/*",
    "tests/**/*"
  ]
}
