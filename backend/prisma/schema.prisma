generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum WaitlistStatus {
  WAITING
  ALLOCATED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations WaitlistEntry[]
  Reservation  Reservation[]
  Order        Order[]
}

model Product {
  id          String   @id @default(uuid())
  brand       String
  title       String
  description String
  price       Float
  statusColor String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ProductVariant[]
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  image     String
  thumbnail String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product           @relation(fields: [productId], references: [id])
  inventory ProductInventory[]
}

model ProductInventory {
  id               String   @id @default(uuid())
  productVariantId String
  size             Int
  total            Int      @default(0)
  reserved         Int      @default(0)
  sold             Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variant       ProductVariant  @relation(fields: [productVariantId], references: [id])
  reservations  Reservation[]
  waitlist      WaitlistEntry[]
  Order         Order[]

  @@unique([productVariantId, size])
}

model Reservation {
  id                 String            @id @default(uuid())
  userId             String
  productInventoryId String
  status             ReservationStatus @default(ACTIVE)
  expiresAt          DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user             User             @relation(fields: [userId], references: [id])
  productInventory ProductInventory @relation(fields: [productInventoryId], references: [id])

  // A user can only have one ACTIVE reservation at a time. This constraint will be enforced by a partial unique index.
}

model WaitlistEntry {
  id                 String         @id @default(uuid())
  userId             String
  productInventoryId String
  status             WaitlistStatus @default(WAITING)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user             User             @relation(fields: [userId], references: [id])
  productInventory ProductInventory @relation(fields: [productInventoryId], references: [id])

  // A user can only have one WAITING entry per inventory
  @@unique([userId, productInventoryId, status], name: "activeWaitlistUnique")
}

model Order {
  id                 String      @id @default(uuid())
  userId             String
  productInventoryId String
  pricePaid          Float
  status             OrderStatus @default(PENDING)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user             User             @relation(fields: [userId], references: [id])
  productInventory ProductInventory @relation(fields: [productInventoryId], references: [id])
}

model PaymentEvent {
  id              String   @id // The idempotency key from external provider
  userId          String
  orderId         String?
  status          String
  amount          Float
  processedAt     DateTime @default(now())

  // We can track payment events for idempotency
}
